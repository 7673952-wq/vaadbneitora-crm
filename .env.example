# Supabase / Lovable Cloud
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Browser-visible (Vite) copies of the same values
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
VITE_SUPABASE_PROJECT_ID=your-project-id

# Backup webhook auth — use a long random secret, e.g. `openssl rand -hex 32`
BACKUP_WEBHOOK_SECRET=your-secret-here

# Weekly report recipient
WEEKLY_REPORT_EMAIL=admin@example.com

# Lovable AI Gateway (auto-managed on Lovable Cloud)
LOVABLE_API_KEY=your-lovable-api-key
